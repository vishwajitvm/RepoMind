# RepoMind Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your configuration and credentials.
# NEVER commit backend/.env to version control.

# --- Environment & Server ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=repomind-insecure-secret-key-change-in-production
HOST=0.0.0.0
PORT=8000

# --- CORS Origins (comma-separated origins allowed to call FastAPI) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repomind
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/repomind

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=repomind_code_chunks
QDRANT_VECTOR_SIZE=384

# --- GitHub MCP & API ---
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_SERVER_COMMAND=

# --- LLM Providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.wavespeed.ai/v1
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# --- Embedding Providers ---
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Observability ---
TRACENEST_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repomind
LANGSMITH_ENDPOINT=
LANGCHAIN_TRACING_V2=false
