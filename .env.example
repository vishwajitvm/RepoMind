# Environment Configuration for RepoMind POC

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/repomind
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/repomind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repomind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Worker
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant Vector Store
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# GitHub MCP & API
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_SERVER_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server

# LLM Providers (API keys configured as available; Ollama serves as local fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Embedding Providers
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Observability (Best Effort)
TRACENEST_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repomind
LANGCHAIN_TRACING_V2=false
